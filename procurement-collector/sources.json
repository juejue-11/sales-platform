    {
      "id": "huang_ansteel",
      "name": "鞍钢智慧招投标",
      "category": "procurement",
      "entry_url": "https://bid.ansteel.cn/zbjjxx/bidding_purchase.html",
      "adapter": "post_json_list",
      "frequency_hours": 24,
      "enabled": true,
      "access_status": "public",
      "access_note": "2026-10-03 本机公开 POST 搜索 API 和详情 HTTP 200；采集货物公告中标题命中破碎机/偏心套的结果。附件可公开读取；投标业务需登录。",
      "api_url": "https://bid.ansteel.cn/inteligentsearch/rest/esinteligentsearch/getFullTextDataNew",
      "queries": [
        {
          "pn": 0,
          "rn": 60,
          "fields": "title",
          "sort": "{\"webdate\":\"0\"}",
          "condition": [
            {
              "fieldName": "title2",
              "equal": "破碎机",
              "isLike": true,
              "likeType": 0
            },
            {
              "fieldName": "categorynum",
              "equal": "001001",
              "isLike": true,
              "likeType": 2
            },
            {
              "fieldName": "cglb",
              "equal": "M",
              "isLike": true,
              "likeType": 0
            }
          ],
          "time": [
            {
              "fieldName": "webdate",
              "startTime": "",
              "endTime": ""
            }
          ],
          "isBusiness": "1"
        },
        {
          "pn": 0,
          "rn": 60,
          "fields": "title",
          "sort": "{\"webdate\":\"0\"}",
          "condition": [
            {
              "fieldName": "title2",
              "equal": "偏心套",
              "isLike": true,
              "likeType": 0
            },
            {
              "fieldName": "categorynum",
              "equal": "001001",
              "isLike": true,
              "likeType": 2
            },
            {
              "fieldName": "cglb",
              "equal": "M",
              "isLike": true,
              "likeType": 0
            }
          ],
          "time": [
            {
              "fieldName": "webdate",
              "startTime": "",
              "endTime": ""
            }
          ],
          "isBusiness": "1"
        }
      ],
      "title_selector": "h3",
      "content_selector": ".paragraph-box",
      "allowed_hosts": [
        "bid.ansteel.cn"
      ],
      "max_items": 120
    },
